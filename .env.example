# Copy to .env.local and fill in. Never commit real keys.

# --- LLM (any OpenAI-compatible provider; defaults are Groq) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Optional: max output tokens per reply (default 150)
# LLM_MAX_TOKENS=150

# --- Game state signing (any long random string) ---
STATE_SECRET=

# --- Optional: per-IP limit on /api/chat, requests per minute (default 20) ---
# CHAT_RATE_LIMIT_PER_MIN=20

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# James's voice (Voices -> ... -> Copy voice ID)
ELEVENLABS_VOICE_ID=
# Holmes's voice, only for the pre-generated evidence lines (npm run audio:fixed)
ELEVENLABS_HOLMES_VOICE_ID=
# Optional: model (default eleven_multilingual_v2; eleven_flash_v2_5 costs about half)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: max live TTS calls per day across all players (default 60)
# TTS_DAILY_CAP=60
